# OpenRouter API key for LLM analysis (Phase 4+). Get one at https://openrouter.ai/keys
# NOTE: if the value ever contains a '#', wrap the whole value in quotes.
OPENROUTER_API_KEY=REPLACE_ME

# Optional attribution shown in the OpenRouter dashboard.
OPENROUTER_APP_URL=https://sdsmanager.com
OPENROUTER_APP_TITLE=SDS Internal Audit

# --- External Fact Check: SERP provider ---
# serp_search() prefers DataForSEO if configured, else Bright Data. Override with
# SERP_PROVIDER=dataforseo | brightdata. Falls back to the other provider on error.
SERP_PROVIDER=dataforseo
SERP_RESULTS_PER_QUERY=20
SERP_LOCATION=us
SERP_LANGUAGE=en

# DataForSEO SERP API (HTTP Basic login:password). https://dataforseo.com
DATAFORSEO_LOGIN=you@example.com
DATAFORSEO_PASSWORD=

# Bright Data SERP proxy (fallback provider)
BRIGHT_DATA_USERNAME=brd-customer-...-zone-serp1
BRIGHT_DATA_PASSWORD=
BRIGHT_DATA_PROXY_HOST=brd.superproxy.io
BRIGHT_DATA_PROXY_PORT=33335
BRIGHT_DATA_VERIFY_SSL=false
